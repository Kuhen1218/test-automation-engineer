
describe('Orders API Test', () => {


    it('GET - Return all orders', () => {
        cy.request('GET', 'http://localhost:3000/').then((response) => {
            expect(response.status).to.eq(200)
            expect(response.body).to.be.an('string')
        })
    })

    it('POST - Create a new order', () => {
        cy.request('POST', 'http://localhost:3000/orders', {
            "product_id": 40,
            "quantity": 1,                                             //create new order 
            "product_name": "Durian",
            "price": 10,
            "created_at": "2025-05-03T05:08:13.208Z",
            "updated_at": "2025-05-03T05:08:13.208Z"
        }).then((response) => {
            expect(response.status).to.eq(201)
        })
    })


    it('PATCH - Update an order', () => {
        cy.request('PATCH', 'http://localhost:3000/orders/13', {     //to update the order
            quantity: 10
        }).then((response) => {
            expect(response.status).to.eq(200)

        })
    })

    it('DELETE - Delete an order', () => {
        cy.request('DELETE', 'http://localhost:3000/orders/10').then((response) => {      // delete order
            expect(response.status).to.eq(200)

        })
    })
})


